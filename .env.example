# Server-only configuration. Never expose these values to the browser.
# Copy to .env.local and fill only in an authorised environment.
# A configured value is not proof that a provider call works.

# Airwallex sandbox credentials and base URL. Use the current official
# documentation for the host and API version. Leave blank until authorised.
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_API_BASE=

# Transactional PostgreSQL connection for the durable execution milestone.
DATABASE_URL=

# Server-side model provider key. The foundation does not make model calls.
MODEL_API_KEY=
